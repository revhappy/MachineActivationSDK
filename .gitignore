# Dependencies
node_modules/

# Build output
dist/
.test-dist/
*.tsbuildinfo

# Stray compiled output that lands next to TypeScript sources
# (the build emits to dist/; these are leftovers and must not be tracked)
/src/**/*.js
/src/**/*.d.ts
/src/**/*.js.map

# Packed tarballs / pack scratch
.pack/
*.tgz

# Vendored inference backend, fetched per machine by `machine fetch-runtime`.
# Host-specific and ~100 MB: downloaded on demand, never committed.
vendor/

# Caches
.npm-cache/
.gstack/

# Logs
npm-debug.log*
*.log

# Local tooling / editor config (machine-specific — never publish)
.claude/
.DS_Store

# Python client build artifacts
__pycache__/
*.pyc
*.egg-info/
clients/python/dist/
